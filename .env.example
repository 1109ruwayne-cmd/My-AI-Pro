# Copy this file to ".env" and fill in what you need. Every line is optional.

# Your AI provider's API key, so people using your AI don't need their own.
# Free Google Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=

# Protects settings, uploads and deletes with a password.
# Strongly recommended if you put your AI online.
ADMIN_PASSWORD=

# Port to run on (default 8000)
PORT=8000

# Largest file you can upload, in MB
MAX_UPLOAD_MB=50

# ---- Other AIs your AI can hand work to (all optional) ----
# Set these here to keep the keys out of config.json and out of the browser.

# OpenHands agent server (pip install openhands-agent-server) - the coding agent
OPENHANDS_API_KEY=

# Dify app API key (Dify -> your app -> API Access -> API Key)
DIFY_API_KEY=

# Free model APIs: whichever one you use for the "Free model APIs" connector
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=

# Ollama needs no key. If yours is protected, put it here:
OLLAMA_API_KEY=
USAGE_DB=usage.db
